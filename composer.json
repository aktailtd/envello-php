{
    "name": "envello/envello-php",
    "description": "Official PHP SDK for the Envello transactional email API",
    "type": "library",
    "license": "MIT",
    "keywords": ["envello", "email", "transactional-email", "api", "sdk"],
    "homepage": "https://envello.dev",
    "support": {
        "source": "https://github.com/aktailtd/envello-php",
        "issues": "https://github.com/aktailtd/envello-php/issues"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Envello\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Envello\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
